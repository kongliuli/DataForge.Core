<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Microsoft.NET.Sdk.Web defaults IsPackable to false; the local web host ships as a dotnet tool. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dataforge-web</ToolCommandName>
    <PackageId>DataForge.Web</PackageId>
    <Version>0.5.0</Version>
    <Authors>DataForge Team</Authors>
    <Description>Web host for DataForge.Jobs — paste or upload YAML and run existing providers.</Description>
    <PackageTags>data processing;ETL;jobs;web;localdts</PackageTags>
    <RepositoryUrl>https://github.com/kongliuli/DataForge.Core</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <Content Update="data\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="data\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DataForge.Jobs\DataForge.Jobs.csproj" />
    <ProjectReference Include="..\..\src\DataForge.Jobs.Sqlite\DataForge.Jobs.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\DataForge.Jobs.PostgreSql\DataForge.Jobs.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\DataForge.Jobs.SqlServer\DataForge.Jobs.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\DataForge.Jobs.Parquet\DataForge.Jobs.Parquet.csproj" />
    <ProjectReference Include="..\..\src\DataForge.Jobs.DuckDB\DataForge.Jobs.DuckDB.csproj" />
    <ProjectReference Include="..\..\src\DataForge.Jobs.MySql\DataForge.Jobs.MySql.csproj" />
    <ProjectReference Include="..\..\src\DataForge.Jobs.Excel\DataForge.Jobs.Excel.csproj" />
    <ProjectReference Include="..\..\src\DataForge.Jobs.Http\DataForge.Jobs.Http.csproj" />
  </ItemGroup>

</Project>
