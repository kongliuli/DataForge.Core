<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>DataForge.Templates</PackageId>
    <Title>DataForge job templates</Title>
    <Authors>DataForge Team</Authors>
    <Description>dotnet new templates for DataForge.Jobs showcase migrations (homo / split / merge).</Description>
    <PackageTags>dotnet-new;templates;dataforge;etl</PackageTags>
    <TargetFramework>net8.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageVersion>0.5.0</PackageVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**;content\**\output\**;content\**\state\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
