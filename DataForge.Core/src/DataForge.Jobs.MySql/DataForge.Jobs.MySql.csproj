<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>DataForge.Jobs.MySql</PackageId>
    <PackageVersion>0.5.0</PackageVersion>
    <Authors>DataForge Team</Authors>
    <Description>MySQL source/sink providers for DataForge.Jobs.</Description>
    <PackageTags>data processing;ETL;jobs;MySQL</PackageTags>
    <RepositoryUrl>https://github.com/kongliuli/DataForge.Core</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>DataForge.Jobs.MySql</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataForge.Jobs\DataForge.Jobs.csproj" />
    <ProjectReference Include="..\DataForge.Core.MySql\DataForge.Core.MySql.csproj" />
  </ItemGroup>

</Project>
