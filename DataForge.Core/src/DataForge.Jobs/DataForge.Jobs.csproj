<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>DataForge.Jobs</PackageId>
    <PackageVersion>0.5.0</PackageVersion>
    <Authors>DataForge Team</Authors>
    <Description>YAML job engine for DataForge — model, parser, runner, cron scheduler, and csv/json providers. Database and file adapters live in DataForge.Jobs.* packages.</Description>
    <PackageTags>data processing;ETL;jobs;migration;yaml</PackageTags>
    <RepositoryUrl>https://github.com/kongliuli/DataForge.Core</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>DataForge.Jobs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.8.4" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataForge.Core\DataForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DataForge.Sync" />
    <InternalsVisibleTo Include="DataForge.Sync.Tests" />
    <InternalsVisibleTo Include="DataForge.Jobs.Sqlite" />
    <InternalsVisibleTo Include="DataForge.Jobs.PostgreSql" />
    <InternalsVisibleTo Include="DataForge.Jobs.SqlServer" />
    <InternalsVisibleTo Include="DataForge.Jobs.Parquet" />
    <InternalsVisibleTo Include="DataForge.Jobs.DuckDB" />
  </ItemGroup>

</Project>
