<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>DataForge.Jobs</PackageId>
    <PackageVersion>0.5.0</PackageVersion>
    <Authors>DataForge Team</Authors>
    <Description>YAML/JSON job engine for DataForge pipelines — model, parser, runner, and built-in source/sink providers.</Description>
    <PackageTags>data processing;ETL;jobs;migration;yaml</PackageTags>
    <RepositoryUrl>https://github.com/kongliuli/DataForge.Core</RepositoryUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>DataForge.Jobs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataForge.Core\DataForge.Core.csproj" />
    <ProjectReference Include="..\DataForge.Core.SqlServer\DataForge.Core.SqlServer.csproj" />
    <ProjectReference Include="..\DataForge.Core.Sqlite\DataForge.Core.Sqlite.csproj" />
    <ProjectReference Include="..\DataForge.Core.PostgreSql\DataForge.Core.PostgreSql.csproj" />
    <ProjectReference Include="..\DataForge.Core.Parquet\DataForge.Core.Parquet.csproj" />
    <ProjectReference Include="..\DataForge.Core.DuckDB\DataForge.Core.DuckDB.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DataForge.Sync" />
    <InternalsVisibleTo Include="DataForge.Sync.Tests" />
    <InternalsVisibleTo Include="DataForge.Jobs.Tests" />
  </ItemGroup>

</Project>
